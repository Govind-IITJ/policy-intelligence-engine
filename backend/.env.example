# Policy Intelligence Engine v0.4.4 secure remote deployment
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:4b-q8_0
OLLAMA_TIMEOUT_SECONDS=300
OLLAMA_NUM_CTX=4096
OLLAMA_THINK=false
OLLAMA_CANDIDATE_REVIEW_LIMIT=64
OLLAMA_CANDIDATE_BATCH_SIZE=16
# Generate a long random value and keep it identical to Vercel BACKEND_API_TOKEN.
API_SHARED_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://policy-intelligence-engine.vercel.app
MAX_UPLOAD_MB=20
MAX_PDF_PAGES=150
MAX_ANALYSIS_CHARS=80000
DATA_DIR=./data
