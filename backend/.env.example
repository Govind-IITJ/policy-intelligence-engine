# Policy Intelligence Engine v0.4.3 — local Ollama configuration
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:4b-q8_0
OLLAMA_TIMEOUT_SECONDS=300
OLLAMA_NUM_CTX=4096
OLLAMA_THINK=false

# Quick-demo default: bounded review; disclose the reviewed/detected ratio.
OLLAMA_CANDIDATE_REVIEW_LIMIT=64
OLLAMA_CANDIDATE_BATCH_SIZE=16

CORS_ORIGINS=http://localhost:5173,http://localhost:3000
MAX_UPLOAD_MB=20
MAX_PDF_PAGES=150
MAX_ANALYSIS_CHARS=250000
DATA_DIR=./data
